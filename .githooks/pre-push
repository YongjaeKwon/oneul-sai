#!/bin/sh
# main에는 직접 push하지 않는다 — 브랜치를 만들어 PR로 올린다(docs/guides/pull-requests.md).
# 비공개 저장소 무료 플랜이라 GitHub 브랜치 보호를 쓸 수 없어 로컬에서 막는다.
# 켜기: git config core.hooksPath .githooks   (scripts/setup-agent-tools.sh가 해 준다)
# 꼭 필요할 때만: ALLOW_MAIN_PUSH=1 git push ...
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
    echo "main에 직접 push할 수 없습니다. 브랜치를 만들어 PR로 올려 주세요 (docs/guides/pull-requests.md)." >&2
    exit 1
  fi
done
exit 0
