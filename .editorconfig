# EditorConfig — 에디터 간 기본 서식 통일 (https://editorconfig.org)
# Prettier가 코드 서식을 맡고, 이 파일은 에디터가 파일을 만들 때의 기본값을 맞춘다.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown은 줄 끝 공백 두 개가 줄바꿈 의미를 가진다
[*.md]
trim_trailing_whitespace = false

# Makefile은 탭이 문법이다
[Makefile]
indent_style = tab
