# ============================================================
# 오늘사이 — 환경 변수 예시
#
# 이 파일은 저장소에 커밋되는 "예시" 파일이다.
# 실제 값은 각 앱/서비스 디렉토리의 .env 파일에 작성한다. (.env는 gitignore)
#
# 각 Backend Service는 자신의 디렉토리에서 .env를 로드한다.
#   예) apps/member-service/.env  (각 디렉토리의 .env.example 참고)
# ============================================================

# ---------- Local PostgreSQL (docker compose up -d) ----------
POSTGRES_USER=oneul
POSTGRES_PASSWORD=oneul
POSTGRES_PORT=5432

# ---------- Service Ports ----------
API_GATEWAY_PORT=4000
MEMBER_SERVICE_PORT=4001
EVENT_SERVICE_PORT=4002
MATCHING_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004
PAYMENT_SERVICE_PORT=4005

# ---------- Database per Service ----------
# 개발 환경에서는 PostgreSQL Instance 하나를 공유하지만,
# 논리 Database의 소유권은 서비스별로 구분한다.
MEMBER_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/member_db
EVENT_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/event_db
# event-service 통합 테스트 전용 — 앱 .env의 TEST_DATABASE_URL
MATCHING_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/matching_db
NOTIFICATION_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/notification_db
PAYMENT_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/payment_db

# ---------- API Gateway → Microservice Routing ----------
# MEMBER_SERVICE_URL은 event-service의 위임 호출도 쓴다(ADR-011, production 필수)
MEMBER_SERVICE_URL=http://localhost:4001
EVENT_SERVICE_URL=http://localhost:4002
MATCHING_SERVICE_URL=http://localhost:4003
NOTIFICATION_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005

# ---------- Client ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# ---------- Kafka (구조만 준비 — docker compose --profile kafka up -d) ----------
KAFKA_BROKERS=localhost:9092

# ---------- 인증 (SPEC-001) — member-service와 api-gateway가 같은 값을 써야 한다(INTERNAL_API_TOKEN은 event-service도) ----------
# 아래는 개발용 값이다. 프로덕션은 `openssl rand -base64 32`로 새로 만든다.
# 액세스 토큰(JWT HS256) 서명 키. base64 디코드 길이 32바이트 이상
JWT_ACCESS_SECRET=b25ldWwtc2FpLWRldi1qd3QtYWNjZXNzLXNlY3JldC1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=
# Gateway ↔ 서비스 공유 비밀(x-internal-token). 32자 이상. api-gateway · member-service · event-service가 같은 값
INTERNAL_API_TOKEN=oneul-sai-dev-internal-api-token-do-not-use-in-production

# ---------- member-service 전용 (설명은 apps/member-service/.env.example · README) ----------
# 액세스 토큰 수명(초) · 리프레시 토큰 수명(초, 30일 = 쿠키 Max-Age)
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000
# 리프레시 쿠키 Secure 속성. 로컬은 false (Safari가 http://localhost에서 Secure 쿠키를 거부). 프로덕션은 true (NODE_ENV=production이면 false 거부)
COOKIE_SECURE=false
# 운영자 웹 origin. client: 'ADMIN' 요청(login · refresh · logout)의 Origin 헤더와 비교. 프로덕션은 https:// 필수. Gateway CORS_ORIGINS에도 있어야 한다
ADMIN_ORIGIN=http://localhost:3001
# seed (pnpm --filter @oneul-sai/member-service db:seed) 전용 — 서비스 부팅에는 필요 없다.
# 비밀번호 우선순위: SEED_ADMIN_PASSWORD_FILE(파일) > SEED_ADMIN_PASSWORD(로컬 전용, production 거부) > stdin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=운영자
# SEED_ADMIN_PASSWORD_FILE=./admin-password.txt
SEED_ADMIN_PASSWORD=admin-local-password
# true면 이미 있는 ADMIN의 비밀번호를 갱신하고 그 계정의 세션을 전부 끊는다 (운영 ADMIN 비밀번호 교체 절차)
SEED_ADMIN_RESET_PASSWORD=false
# 권고(.env가 아니라 실행 환경에서): UV_THREADPOOL_SIZE=8 — scrypt 동시 실행 4 + DB 드라이버 여유 (docs/architecture/tech-stack.md 함정 9)

# ---------- api-gateway 전용 (설명은 apps/api-gateway/.env.example · README) ----------
# CORS 허용 origin(쉼표 구분). `*` 금지(credentials: true). `POST /api/v1/auth/*`의 Origin 확인에도 쓴다
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# 로그인 · refresh · 가입 · 비밀번호 확인 경로의 IP 단위 분당 허용 횟수(인메모리 토큰 버킷, 단일 인스턴스)
RATE_LIMIT_AUTH_PER_MINUTE=10

# ---------- e2e (apps/e2e, Playwright — 설명은 apps/e2e/.env.example · README) ----------
# 운영자 계정은 위 SEED_ADMIN_*와 같아야 한다. 로컬은 떠 있는 dev 서버를 다시 쓴다
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=
