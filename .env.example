# ============================================================
# 오늘사이 — 환경 변수 예시
#
# 이 파일은 저장소에 커밋되는 "예시" 파일이다.
# 실제 값은 각 앱/서비스 디렉토리의 .env 파일에 작성한다. (.env는 gitignore)
#
# 각 Backend Service는 자신의 디렉토리에서 .env를 로드한다.
#   예) apps/member-service/.env  (각 디렉토리의 .env.example 참고)
# ============================================================

# ---------- Local PostgreSQL (docker compose up -d) ----------
POSTGRES_USER=oneul
POSTGRES_PASSWORD=oneul
POSTGRES_PORT=5432

# ---------- Service Ports ----------
API_GATEWAY_PORT=4000
MEMBER_SERVICE_PORT=4001
EVENT_SERVICE_PORT=4002
MATCHING_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004
PAYMENT_SERVICE_PORT=4005

# ---------- Database per Service ----------
# 개발 환경에서는 PostgreSQL Instance 하나를 공유하지만,
# 논리 Database의 소유권은 서비스별로 구분한다.
MEMBER_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/member_db
EVENT_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/event_db
MATCHING_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/matching_db
NOTIFICATION_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/notification_db
PAYMENT_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/payment_db

# ---------- API Gateway → Microservice Routing ----------
MEMBER_SERVICE_URL=http://localhost:4001
EVENT_SERVICE_URL=http://localhost:4002
MATCHING_SERVICE_URL=http://localhost:4003
NOTIFICATION_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005

# ---------- Client ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# ---------- Kafka (구조만 준비 — docker compose --profile kafka up -d) ----------
KAFKA_BROKERS=localhost:9092
