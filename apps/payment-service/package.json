{
  "name": "@oneul-sai/payment-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@oneul-sai/config": "workspace:*",
    "@oneul-sai/constants": "workspace:*",
    "@oneul-sai/contracts": "workspace:*",
    "@oneul-sai/logger": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1",
    "@oneul-sai/eslint-config": "workspace:*",
    "@oneul-sai/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9",
    "prisma": "7.10.0",
    "tsc-watch": "^7.2.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.2"
  }
}
