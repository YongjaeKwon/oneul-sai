generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"] // SPEC-003 개발 승인 N (2026-09-24) — 부분 유니크 인덱스 (D3)
}

datasource db {
  provider = "postgresql"
}

// SPEC-002 · SPEC-003 9절. Prisma가 표현하지 못하는 CHECK 제약은 마이그레이션 SQL(init_event · add_application · add_schedule_condition_columns)에만 있다.

// 행사를 마친 상태는 Step 5(SPEC-005)가 값과 전이를 함께 더한다 (D8)
enum ScheduleStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

// 모임 상품 — 회차가 함께 쓰는 제목 · 설명 (D1)
model Meetup {
  id          String   @id @default(uuid())
  title       String
  description String   @default("")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  schedules Schedule[]
}

// 회차(참가자 화면: 일정). 참가비 · 정원 · 시각 · 연령대 · 장소는 회차에만 있다 (D1)
model Schedule {
  id                   String         @id @default(uuid())
  meetupId             String
  startsAt             DateTime       @db.Timestamptz(3)
  endsAt               DateTime       @db.Timestamptz(3)
  applyDeadlineAt      DateTime       @db.Timestamptz(3) // 필수 — 운영자 두 번째 답변 (D7)
  // 남녀 참가비 — 같을 수도 다를 수도 있다. "같은 금액" 여부는 저장하지 않는다 (D3)
  priceMale            Int
  priceFemale          Int
  priceNote            String? // 참가비 보조 문구 — 예 "커피 1잔 포함". 표시 값 (D17, 개정 2026-10-14)
  capacityMale         Int
  capacityFemale       Int
  minPerGender         Int? // 성별 최소 인원 — 운영자 화면 표시 값. 서버 판정 · 자동 취소 없음 (D17, 개정 2026-10-14)
  // 성별 연령대(출생연도 범위) — 성별마다 한 쌍, 비우면 그 성별 제한 없음. 여성 두 열은 개정 2026-10-14에 더했다 (D16)
  maleMinBirthYear     Int?
  maleMaxBirthYear     Int?
  femaleMinBirthYear   Int?
  femaleMaxBirthYear   Int?
  participantCondition String? // 참가 조건 문구 — 예 "90년대생 직장인". 판정 없음 (D17, 개정 2026-10-14)
  venueArea            String
  // 아래 넷은 운영자 전용 — 공개 응답에 절대 싣지 않는다 (D4, 12절)
  venueName            String?
  venueAddress         String?
  venueDirections      String?
  venueMapUrl          String?
  status               ScheduleStatus @default(DRAFT)
  cancelReason         String?
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)

  meetup       Meetup        @relation(fields: [meetupId], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([meetupId, startsAt])
}

// member_db의 Gender와 값이 같다. 신청 시점 스냅샷에만 쓴다 (SPEC-003 D1)
enum Gender {
  MALE
  FEMALE
}

// 활성 신청 = CANCELLED가 아닌 신청(접수 포함). 자리 잡은 신청 = PENDING · CONFIRMED (SPEC-003 D14).
// 값 순서는 ADD VALUE 순서다 — PENDING · CANCELLED(add_application) → CONFIRMED · APPLIED(add_application_statuses, D19).
// contracts APPLICATION_STATUSES도 같은 순서.
enum ApplicationStatus {
  PENDING // 입금 대기 — 참가 가능 안내를 받아 자리를 잡았다
  CANCELLED
  CONFIRMED // 참가 확정 — payment.completed.v1 (SPEC-004 D2)
  APPLIED // 접수 — 자리를 잡지 않았다 (SPEC-003 개정 2026-10-14)
}

enum ApplicationCancelledBy {
  MEMBER
  ADMIN
  SCHEDULE
}

// 참가 신청 (SPEC-003). 회원은 ID로만 참조한다 — FK 없음 (ADR-007). 이름 · 휴대폰 · 출생연도는 저장하지 않는다 (D1)
model Application {
  id          String                  @id @default(uuid())
  scheduleId  String
  memberId    String
  gender      Gender // 신청 시점 스냅샷 (D1)
  price       Int // 신청 시점 그 성별의 참가비 (D1)
  status      ApplicationStatus       @default(APPLIED) // 접수로 태어난다 (SPEC-003 D14)
  cancelledBy ApplicationCancelledBy? // CANCELLED일 때만 (CHECK)
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  // 한 회차 · 한 회원의 활성 신청은 하나 — 최종 방어선 (D3). 접수도 활성이다.
  // 생성되는 복합 선택자 scheduleId_memberId는 쓰지 않는다 — CANCELLED 행은 여러 개일 수 있다 (9절)
  @@unique([scheduleId, memberId], map: "Application_active_member_key", where: raw("\"status\" <> 'CANCELLED'"))
  @@index([scheduleId, createdAt])
  @@index([memberId, createdAt])
}
