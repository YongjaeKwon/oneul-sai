PORT=4002
DATABASE_URL=postgresql://oneul:oneul@localhost:5432/event_db
NODE_ENV=development

# Gateway ↔ 서비스 공유 비밀(x-internal-token). api-gateway와 같은 값이어야 한다. 32자 이상. 없으면 부팅하지 않는다.
# 아래는 개발용 값이다. 프로덕션은 `openssl rand -base64 32`로 새로 만든다.
INTERNAL_API_TOKEN=oneul-sai-dev-internal-api-token-do-not-use-in-production

# 통합 테스트(test:integration) 전용 DB. vitest globalSetup만 읽는다 — 서비스 부팅에는 쓰지 않는다.
# 이름이 _test_db로 끝나야 한다(아니면 migrate 전에 실패). DB가 없으면 prisma migrate deploy가 만든다.
TEST_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/event_test_db
