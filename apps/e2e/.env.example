# @oneul-sai/e2e — 브라우저 e2e(Playwright) 설정 예시. 복사해 apps/e2e/.env를 만든다(.env는 gitignore).
# 운영자 계정은 로컬 member_db에 seed한 계정과 같아야 한다(apps/member-service의 SEED_ADMIN_*).
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=

# 로컬 기본값 — 떠 있는 dev 서버를 다시 쓴다
E2E_API_URL=http://localhost:4000
E2E_WEB_URL=http://localhost:3000
E2E_ADMIN_URL=http://localhost:3001

# Playwright가 서버를 직접 띄울 때(CI, 또는 로컬에서 그 서버가 떠 있지 않을 때)만 쓴다 — 서비스마다 DATABASE_URL로 넘긴다
E2E_MEMBER_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/member_db
E2E_EVENT_DATABASE_URL=postgresql://oneul:oneul@localhost:5432/event_db
