PORT=4000
NODE_ENV=development
MEMBER_SERVICE_URL=http://localhost:4001
EVENT_SERVICE_URL=http://localhost:4002
MATCHING_SERVICE_URL=http://localhost:4003
NOTIFICATION_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005

# ---------- 인증 (SPEC-001) ----------
# 액세스 토큰(JWT HS256) 검증 키. member-service와 같은 값이어야 한다.
# 아래는 개발용 값이다. 프로덕션은 `openssl rand -base64 32`로 새로 만든다 (base64 디코드 길이 32바이트 이상).
JWT_ACCESS_SECRET=b25ldWwtc2FpLWRldi1qd3QtYWNjZXNzLXNlY3JldC1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=
# Gateway → 서비스 공유 비밀(x-internal-token). member-service와 같은 값이어야 한다. 32자 이상.
# 아래는 개발용 값이다. 프로덕션은 `openssl rand -base64 32`로 새로 만든다.
INTERNAL_API_TOKEN=oneul-sai-dev-internal-api-token-do-not-use-in-production
# CORS 허용 origin(쉼표 구분). `*` 금지(credentials: true). 프로덕션은 https만 허용한다(localhost 제외 http는 부팅 거부).
# `POST /api/v1/auth/*`의 Origin 헤더도 이 목록으로 확인한다.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# 로그인 · refresh · 가입 · 비밀번호 변경 · 프로필 수정 · 탈퇴의 IP 단위 분당 허용 횟수(인메모리 토큰 버킷, 단일 인스턴스)
RATE_LIMIT_AUTH_PER_MINUTE=10
