PORT=4001
DATABASE_URL=postgresql://oneul:oneul@localhost:5432/member_db
NODE_ENV=development

# ---------- 인증 (SPEC-001) ----------
# 액세스 토큰(JWT HS256) 서명 키. api-gateway와 같은 값이어야 한다.
# 아래는 개발용 값이다. 프로덕션은 `openssl rand -base64 32`로 새로 만든다 (base64 디코드 길이 32바이트 이상).
JWT_ACCESS_SECRET=b25ldWwtc2FpLWRldi1qd3QtYWNjZXNzLXNlY3JldC1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24=
# 액세스 토큰 수명(초)
JWT_ACCESS_TTL=900
# 리프레시 토큰 수명(초) = 30일
REFRESH_TTL=2592000
# 리프레시 쿠키의 Secure 속성. 로컬은 false (Safari가 http://localhost에서 Secure 쿠키를 거부한다). 프로덕션은 true — NODE_ENV=production이면 false를 거부한다.
COOKIE_SECURE=false
# Gateway ↔ 서비스 공유 비밀(x-internal-token). api-gateway와 같은 값이어야 한다. 32자 이상.
# 아래는 개발용 값이다. 프로덕션은 `openssl rand -base64 32`로 새로 만든다.
INTERNAL_API_TOKEN=oneul-sai-dev-internal-api-token-do-not-use-in-production
# 운영자 웹 origin. onulsai_rt_admin 쿠키로 오는 refresh · logout의 Origin 헤더와 비교한다.
ADMIN_ORIGIN=http://localhost:3001

# ---------- seed (pnpm db:seed) 전용 ----------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=운영자
# 비밀번호는 파일(SEED_ADMIN_PASSWORD_FILE) 또는 stdin으로 준다. 우선순위: 파일 > SEED_ADMIN_PASSWORD > stdin.
# SEED_ADMIN_PASSWORD(env)는 로컬 전용이며 NODE_ENV=production에서는 거부한다.
# SEED_ADMIN_PASSWORD_FILE=./admin-password.txt
SEED_ADMIN_PASSWORD=admin-local-password
# true면 이미 있는 ADMIN의 비밀번호를 갱신한다 (운영 ADMIN 비밀번호 교체 절차)
SEED_ADMIN_RESET_PASSWORD=false
